{
  "name": "smart-order",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d pg adminer",
    "db:down": "docker compose down",
    "db:migrate": "bun --env-file .env ./packages/db/src/migrate.ts",
    "db:seed": "bun --env-file .env ./packages/db/src/seed.ts",
    "dev": "turbo dev --filter=@smart-order/api --filter=@smart-order/web --filter=@smart-order/docs",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "bun-types": "^1.3.9",
    "lefthook": "^1.7.15",
    "oxlint": "^0.15.15",
    "turbo": "^2.5.6",
    "typescript": "^5.8.2"
  }
}
